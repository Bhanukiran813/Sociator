# ==========================================
# Sociator Backend Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Sociator API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (Allowed frontend URLs, comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sociator_db"

# External APIs (Keep empty until ready to integrate)
YOUTUBE_API_KEY=""
